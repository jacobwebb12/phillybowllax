---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Field Map" description="Field map for the Philly Bowl Championship — coming soon.">
  <section class="relative py-32 bg-brand-dark overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/90 to-brand-blue/20"></div>
    <div class="relative z-10 mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-subhead text-brand-light-blue tracking-[0.2em] text-sm mb-4 uppercase">Navigate the Venue</p>
      <h1 class="text-5xl md:text-6xl lg:text-7xl text-white mb-6">Field Map</h1>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="mx-auto max-w-[1000px] px-4 sm:px-6 lg:px-8">
      <div class="w-full rounded-lg border border-gray-200 overflow-hidden shadow-sm bg-brand-off-white">
        <iframe
          src="/images/WSFS%20Map%20(1).pdf"
          title="WSFS Sports Complex Field Map"
          class="w-full h-[70vh] md:h-[85vh]"
        ></iframe>
      </div>
      <p class="text-center text-brand-gray text-sm mt-6">
        Trouble viewing?
        <a
          href="/images/WSFS%20Map%20(1).pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-blue hover:text-brand-light-blue underline"
        >
          Open the field map PDF
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
